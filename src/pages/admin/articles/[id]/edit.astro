---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ArticleForm from '../../../../components/admin/ArticleForm';

const { id } = Astro.params;
const articleId = parseInt(id!, 10);
---

<AdminLayout title={`Edit Article`}>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-foreground">Edit Article</h1>
      <p class="text-muted-foreground text-sm mt-1 line-clamp-1">Loading from local storage...</p>
    </div>

    <div class="bg-card rounded-xl border border-border shadow-sm p-6 lg:p-8">
      <ArticleForm mode="edit" articleId={articleId} client:load />
    </div>
  </div>
</AdminLayout>
