---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ArticleForm from '../../../../components/admin/ArticleForm';
import BackButton from '../../../../components/admin/BackButton.astro';

const { id } = Astro.params;
const articleId = parseInt(id!, 10);
---

<AdminLayout title={`Edit Article`}>
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <BackButton href="/admin/articles" label="Back to Articles" />
      <div>
        <h1 class="text-2xl font-bold text-base-content">Edit Article</h1>
        <p class="text-base-content/60 text-sm mt-1 line-clamp-1">Loading from local storage...</p>
      </div>
    </div>

    <div class="bg-base-100 rounded-xl border border-base-300 shadow-sm p-6 lg:p-8">
      <ArticleForm mode="edit" articleId={articleId} client:load />
    </div>
  </div>
</AdminLayout>
