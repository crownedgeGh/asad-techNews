---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ArticleForm from '../../../../components/admin/ArticleForm';
import { db } from '../../../../db';
import { articles } from '../../../../db/schema';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;
const articleId = parseInt(id!, 10);

let article: typeof import('../../../../db/schema').articles.$inferSelect | undefined;
try {
  const rows = await db.select().from(articles).where(eq(articles.id, articleId));
  article = rows[0];
} catch {
  return Astro.redirect('/admin/articles');
}

if (!article) {
  return Astro.redirect('/admin/articles');
}

const initialData = {
  id: article.id,
  title: article.title,
  slug: article.slug,
  content: article.content,
  category: article.category,
  coverImage: article.coverImage ?? '',
  published: article.published,
};
---

<AdminLayout title={`Edit: ${article.title}`}>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-base-content">Edit Article</h1>
      <p class="text-base-content/60 text-sm mt-1 line-clamp-1">{article.title}</p>
    </div>

    <div class="bg-base-100 rounded-xl border border-base-300 shadow-sm p-6 lg:p-8">
      <ArticleForm mode="edit" initialData={initialData} client:load />
    </div>
  </div>
</AdminLayout>
