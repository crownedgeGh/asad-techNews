---
import Layout from '../layouts/Layout.astro';
import { NAV_SECTIONS } from '../lib/seo';
---

<Layout title="Page Not Found" description="The page you were looking for could not be found." noindex={true}>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <p class="text-6xl font-heading font-extrabold text-primary mb-4">404</p>
    <h1 class="text-2xl sm:text-3xl font-heading font-bold text-slate-900 dark:text-white mb-4">
      This page could not be found
    </h1>
    <p class="text-slate-600 dark:text-slate-400 mb-10">
      The article may have been moved or removed. Try one of these sections instead:
    </p>
    <nav aria-label="Site sections" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 mb-10">
      {NAV_SECTIONS.map((s) => (
        <a href={s.href} class="text-primary hover:text-secondary font-medium transition-colors">{s.label}</a>
      ))}
    </nav>
    <a href="/" class="inline-block px-6 py-3 bg-primary hover:bg-secondary text-white font-medium rounded-md transition-colors">
      Back to Home
    </a>
  </div>
</Layout>
