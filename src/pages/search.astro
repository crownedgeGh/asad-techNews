---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { db } from '../db';
import { articles } from '../db/schema';
import { and, eq, or, ilike, desc } from 'drizzle-orm';
import { formatDate, formatViews, excerptFromContent } from '../lib/format';
import { breadcrumbSchema } from '../lib/schema';
import { SITE } from '../lib/seo';

export const prerender = false;

const query = (Astro.url.searchParams.get('q') || '').trim().slice(0, 100);

let results: (typeof articles.$inferSelect)[] = [];
if (query) {
  try {
    const pattern = `%${query}%`;
    results = await db
      .select()
      .from(articles)
      .where(and(eq(articles.published, true), or(ilike(articles.title, pattern), ilike(articles.content, pattern))))
      .orderBy(desc(articles.createdAt))
      .limit(30);
  } catch (e) {
    console.error('Search query failed:', e);
  }
}

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Search', url: '/search' }];
const jsonLd = breadcrumbSchema(crumbs);

// The empty search page is a useful, indexable entry point; result pages are
// noindex,follow to avoid indexing thin/duplicate query permutations.
const title = query ? `Search results for “${query}”` : 'Search';
const description = query
  ? `Search results for “${query}” on ${SITE.name}.`
  : `Search ${SITE.name} for technology news, product launches, and reviews.`;
---

<Layout title={title} description={description} canonical={`${SITE.url}/search`} noindex={!!query} jsonLd={jsonLd}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={crumbs} class="mb-6" />
    <h1 class="text-3xl font-heading font-bold text-slate-900 dark:text-white mb-6">Search</h1>

    <form method="get" action="/search" role="search" class="flex gap-2 mb-10">
      <label for="q" class="sr-only">Search articles</label>
      <input
        id="q"
        name="q"
        type="search"
        value={query}
        placeholder="Search tech news, reviews, products…"
        autocomplete="off"
        class="w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm dark:text-white placeholder-slate-400"
      />
      <button type="submit" class="px-5 py-2.5 bg-primary hover:bg-secondary text-white font-medium rounded-md transition-colors text-sm whitespace-nowrap shadow-sm">
        Search
      </button>
    </form>

    {query && (
      <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
        {results.length === 0
          ? `No results found for “${query}”.`
          : `${results.length} result${results.length === 1 ? '' : 's'} for “${query}”.`}
      </p>
    )}

    <div class="flex flex-col">
      {results.map((article) => (
        <ArticleCard
          title={article.title}
          excerpt={excerptFromContent(article.content)}
          imageUrl={article.coverImage || '/logo.png'}
          category={article.category}
          slug={article.slug}
          date={formatDate(article.createdAt)}
          views={formatViews(article.views)}
        />
      ))}
    </div>
  </div>
</Layout>
