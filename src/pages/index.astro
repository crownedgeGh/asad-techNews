---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { db } from '../db';
import { articles } from '../db/schema';
import { eq, desc, and } from 'drizzle-orm';
import { formatDateTime, formatDate, formatViews } from '../lib/format';

export const prerender = false;

let allArticles: (typeof articles.$inferSelect)[] = [];
try {
  allArticles = await db
    .select()
    .from(articles)
    .where(eq(articles.published, true))
    .orderBy(desc(articles.createdAt))
    .limit(30);
} catch (e) {
  console.error('Failed to load articles for homepage:', e);
}

let featuredArticles: (typeof articles.$inferSelect)[] = [];
try {
  featuredArticles = await db
    .select()
    .from(articles)
    .where(and(eq(articles.published, true), eq(articles.featured, true)))
    .orderBy(desc(articles.createdAt))
    .limit(6);
} catch (e) {
  console.error('Failed to load featured articles for homepage:', e);
}
---

<Layout title="Home">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

      {/* Main Content Area (Left 2 cols) */}
      <div class="lg:col-span-2">

        {/* Latest News Section */}
        <section>
          <h2 class="text-3xl font-heading font-bold text-slate-900 dark:text-white mb-6 uppercase border-b border-slate-300 dark:border-slate-800 pb-3">LATEST <span class="text-primary font-light">NEWS</span></h2>
          <div class="flex flex-col">
            {allArticles.length === 0 && (
              <p class="text-slate-500 dark:text-slate-400 py-12 text-center">No articles published yet.</p>
            )}
            {allArticles.map(article => (
              <ArticleCard
                title={article.title}
                imageUrl={article.coverImage || '/logo.png'}
                category={article.category}
                slug={article.slug}
                date={formatDateTime(article.createdAt)}
                views={formatViews(article.views)}
              />
            ))}
          </div>
        </section>

      </div>

      {/* Sidebar Area (Right 1 col) for Ads */}
      <aside class="lg:col-span-1">
        <div class="sticky top-24 space-y-8">
          <div class="bg-white dark:bg-slate-800 rounded-lg p-6 flex flex-col items-center justify-center border border-slate-200 dark:border-slate-700 shadow-sm">
            <span class="text-slate-400 dark:text-slate-500 font-medium text-sm uppercase tracking-widest mb-2">Advertisement</span>
            {/* Google Ad slot would go here */}
            <div class="w-full max-w-[300px] aspect-[1/2] bg-slate-100 dark:bg-slate-700 rounded flex items-center justify-center">
              <span class="text-slate-500 dark:text-slate-400 font-bold text-center px-2">300x600 Ad Space</span>
            </div>
          </div>

          {/* Featured Section */}
          {featuredArticles.length > 0 && (
            <section class="bg-white dark:bg-slate-800 rounded-lg p-6 border border-slate-200 dark:border-slate-700 shadow-sm">
              <h2 class="text-xl font-heading font-bold text-slate-900 dark:text-white mb-4 uppercase border-b border-slate-300 dark:border-slate-800 pb-3">FEATURED <span class="text-primary font-light">NEWS</span></h2>
              <div class="featured-scroll flex flex-col divide-y divide-slate-200 dark:divide-slate-700 max-h-[50rem] overflow-y-auto pr-1">
                {featuredArticles.map(article => (
                  <a href={`/article/${article.slug}`} class="group block py-5 first:pt-0">
                    <div class="rounded-lg overflow-hidden aspect-video ring-1 ring-slate-200 dark:ring-slate-800">
                      <img
                        src={article.coverImage || '/logo.png'}
                        alt={article.title}
                        loading="lazy"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>
                    <h3 class="font-heading font-bold text-lg leading-snug text-slate-800 dark:text-slate-100 group-hover:text-primary transition-colors line-clamp-2 mt-3">{article.title}</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">{formatDate(article.createdAt)}</p>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>
      </aside>
      
    </div>
  </div>
</Layout>
