---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ArticlesTable from '../../../components/admin/ArticlesTable';
import RunPipelineButton from '../../../components/admin/RunPipelineButton';
---

<AdminLayout title="Articles">
  <div class="space-y-6">
    <!-- Page header -->
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div>
          <h1 class="text-2xl font-bold text-base-content">Articles</h1>
          <p class="text-base-content/60 text-sm mt-1">Manage all your articles</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <RunPipelineButton client:only="react" />
        <a href="/admin/articles/new" class="inline-flex items-center gap-2 rounded-md bg-primary text-primary-content px-4 py-2 text-sm font-medium shadow-sm hover:bg-primary/90 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Post Article
        </a>
      </div>
    </div>

    <!-- Articles table (React island) -->
    <ArticlesTable client:only="react" />
  </div>
</AdminLayout>
