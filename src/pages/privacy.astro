---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { breadcrumbSchema } from '../lib/schema';
import { SITE } from '../lib/seo';

const crumbs = [{ name: 'Home', url: '/' }, { name: 'Privacy Policy', url: '/privacy' }];
const jsonLd = breadcrumbSchema(crumbs);
const description = `Privacy Policy for ${SITE.name} — what data we collect, how we use it, and the choices you have.`;
---

<Layout title="Privacy Policy" description={description} jsonLd={jsonLd}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={crumbs} class="mb-6" />
    <article class="prose prose-lg dark:prose-invert prose-headings:font-heading max-w-none font-body">
      <h1>Privacy Policy</h1>
      <p>
        This Privacy Policy explains how {SITE.name} ("we", "us") handles information when you visit our
        website. We aim to collect as little personal data as possible.
      </p>
      <h2>Information we collect</h2>
      <p>
        We collect basic, non-identifying analytics such as pages viewed and general device type to
        understand what content is useful. If you subscribe to our newsletter or contact us, we store the
        email address you provide for that purpose only.
      </p>
      <h2>Cookies</h2>
      <p>
        We use essential cookies to remember your theme preference (light or dark) and may use privacy-
        respecting analytics cookies. You can clear or block cookies in your browser at any time.
      </p>
      <h2>Third-party services</h2>
      <p>
        Some pages may include content or advertising served by third parties, who may process data under
        their own privacy policies. We do not sell your personal information.
      </p>
      <h2>Your choices</h2>
      <p>
        You can unsubscribe from emails at any time and request that we delete any personal data you've
        given us by reaching out via our <a href="/contact">Contact</a> page.
      </p>
      <h2>Changes</h2>
      <p>
        We may update this policy from time to time. Continued use of the site after changes constitutes
        acceptance of the revised policy.
      </p>
    </article>
  </div>
</Layout>
