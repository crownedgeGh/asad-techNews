---
import Layout from '../../layouts/Layout.astro';
import SocialShare from '../../components/SocialShare';
import Comments from '../../components/Comments';
import RelatedArticles from '../../components/RelatedArticles.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { db } from '../../db';
import { articles, users, comments } from '../../db/schema';
import { eq, sql, and, desc } from 'drizzle-orm';
import { formatDate, estimateReadTime, excerptFromContent, stripHtml } from '../../lib/format';
import { injectLinkPreviews } from '../../lib/renderArticleContent';
import { articleUrl, categoryPath, extractTopics, absoluteUrl } from '../../lib/seo';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';

export const prerender = false;

const { slug } = Astro.params;

const rows = await db
  .select({
    id: articles.id,
    title: articles.title,
    slug: articles.slug,
    content: articles.content,
    coverImage: articles.coverImage,
    category: articles.category,
    published: articles.published,
    views: articles.views,
    likes: articles.likes,
    commentsCount: articles.commentsCount,
    createdAt: articles.createdAt,
    updatedAt: articles.updatedAt,
    authorName: users.name,
    credit: articles.credit,
  })
  .from(articles)
  .leftJoin(users, eq(articles.authorId, users.id))
  .where(eq(articles.slug, slug!));

const article = rows[0];

if (!article || !article.published) {
  return new Response(null, { status: 404 });
}

// Best-effort view counter; failures shouldn't block rendering the page.
db.update(articles)
  .set({ views: sql`${articles.views} + 1` })
  .where(eq(articles.id, article.id))
  .catch((e) => console.error('Failed to increment views:', e));

const canonicalUrl = articleUrl(article.slug);
const currentUrl = canonicalUrl;
const authorName = article.authorName ?? 'Staff Writer';
const dateStr = formatDate(article.createdAt);
const timeToRead = estimateReadTime(article.content);
const coverImage = article.coverImage || '/logo.png';

// --- SEO / structured data -------------------------------------------------
const metaDescription = excerptFromContent(article.content, 160);
const keywords = extractTopics(article.title, article.category);
const publishedIso = new Date(article.createdAt).toISOString();
const modifiedIso = new Date(article.updatedAt ?? article.createdAt).toISOString();
const wordCount = stripHtml(article.content).split(' ').filter(Boolean).length;
const isReview = article.category === 'Reviews';

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: article.category, url: categoryPath(article.category) },
  { name: article.title, url: `/article/${article.slug}` },
];

const jsonLd = [
  articleSchema({
    headline: article.title,
    description: metaDescription,
    url: canonicalUrl,
    image: coverImage,
    datePublished: publishedIso,
    dateModified: modifiedIso,
    authorName: article.credit || authorName,
    section: article.category,
    keywords,
    wordCount,
    type: isReview ? 'Review' : 'NewsArticle',
  }),
  breadcrumbSchema(breadcrumbItems),
];

let renderedContent = article.content;
try {
  renderedContent = await injectLinkPreviews(article.content);
} catch (e) {
  console.error('Failed to inject link previews:', e);
}

const initialLiked = Astro.cookies.get(`liked_${article.id}`)?.value === '1';

let initialComments: { id: number; name: string | null; body: string; upvotes: number; createdAt: Date; upvoted: boolean }[] = [];
try {
  const commentRows = await db
    .select()
    .from(comments)
    .where(eq(comments.articleId, article.id))
    .orderBy(desc(comments.createdAt));
  initialComments = commentRows.map((c) => ({
    id: c.id,
    name: c.name,
    body: c.body,
    upvotes: c.upvotes,
    createdAt: c.createdAt,
    upvoted: Astro.cookies.get(`upvoted_${c.id}`)?.value === '1',
  }));
} catch (e) {
  console.error('Failed to load comments:', e);
}

let featured: { id: number; title: string; slug: string; coverImage: string | null; createdAt: Date }[] = [];
try {
  featured = await db
    .select({ id: articles.id, title: articles.title, slug: articles.slug, coverImage: articles.coverImage, createdAt: articles.createdAt })
    .from(articles)
    .where(and(eq(articles.published, true), eq(articles.featured, true)))
    .orderBy(desc(articles.createdAt))
    .limit(7);
  featured = featured.filter((a) => a.id !== article.id);
} catch (e) {
  console.error('Failed to load featured articles:', e);
}
---

<Layout
  title={article.title}
  description={metaDescription}
  canonical={canonicalUrl}
  image={absoluteUrl(coverImage)}
  imageAlt={article.title}
  type="article"
  keywords={keywords}
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  author={article.credit || authorName}
  section={article.category}
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={breadcrumbItems} class="mb-8" />
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

      {/* Main Article Content (Left 2 cols) */}
      <article class="lg:col-span-2">
        {/* Article Header */}
        <header class="mb-8">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-sm font-bold uppercase tracking-wider text-primary dark:text-primary">{article.category}</span>
            <span class="text-sm text-slate-500 dark:text-slate-400">&bull;</span>
            <time datetime={publishedIso} class="text-sm text-slate-500 dark:text-slate-400">{dateStr}</time>
            <span class="text-sm text-slate-500 dark:text-slate-400">&bull;</span>
            <span class="text-sm text-slate-500 dark:text-slate-400">{timeToRead}</span>
          </div>
          <h1 class="text-2xl sm:text-3xl md:text-5xl font-heading font-extrabold text-slate-900 dark:text-white leading-tight mb-6">
            {article.title}
          </h1>
          <div class="flex items-center gap-4">
            <div>
              {article.credit ? (
                <details class="group">
                  <summary class="cursor-pointer list-none font-medium text-slate-900 dark:text-white select-none w-fit">
                    Source <span class="text-xs text-slate-400 dark:text-slate-500 group-open:hidden">(click to view)</span>
                  </summary>
                  <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Credit: {article.credit}</p>
                </details>
              ) : (
                <p class="font-medium text-slate-900 dark:text-white">{authorName}</p>
              )}
              <p class="text-sm text-slate-500 dark:text-slate-400">{article.category}</p>
            </div>
          </div>
        </header>

        {/* Social Share */}
        <SocialShare
          client:load
          url={currentUrl}
          title={article.title}
          slug={article.slug}
          initialLikes={article.likes}
          initialLiked={initialLiked}
        />

        {/* Cover Image (LCP — eager + high priority) */}
        <div class="mb-10 rounded-2xl overflow-hidden shadow-lg aspect-video">
          <img
            src={coverImage}
            alt={article.title}
            width="1280"
            height="720"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>

        {/* Article Body */}
        <div class="prose prose-lg dark:prose-invert prose-headings:font-heading prose-a:text-primary dark:prose-a:text-primary hover:prose-a:text-secondary max-w-none font-body">
          <div set:html={renderedContent} />
        </div>

        {/* Inline Ad Slot (Simulated) */}
        <div class="my-10 bg-slate-100 dark:bg-slate-800 rounded-lg p-6 flex flex-col items-center justify-center min-h-[150px] border border-slate-200 dark:border-slate-700">
           <span class="text-slate-400 dark:text-slate-500 font-medium text-sm uppercase tracking-widest mb-2">Advertisement</span>
           <div class="w-full max-w-[728px] h-[90px] bg-slate-200 dark:bg-slate-700 rounded flex items-center justify-center">
             <span class="text-slate-500 dark:text-slate-400 font-bold">728x90 Leaderboard</span>
           </div>
        </div>

        {/* Comments */}
        <Comments client:load slug={article.slug} initialComments={initialComments} />

        {/* Author Bio Box */}
        {!article.credit && (
          <div class="bg-slate-50 dark:bg-slate-800/50 rounded-xl p-8 my-8 flex flex-col sm:flex-row gap-6 items-center sm:items-start border border-slate-200 dark:border-slate-700/50">
             <div class="w-24 h-24 rounded-full bg-slate-200 dark:bg-slate-700 shrink-0 flex items-center justify-center text-3xl font-extrabold text-slate-400 dark:text-slate-500">
               {authorName.charAt(0).toUpperCase()}
             </div>
             <div>
               <h4 class="text-xl font-bold text-slate-900 dark:text-white mb-2">About {authorName}</h4>
               <p class="text-slate-600 dark:text-slate-300">Contributor at The Lumen Tech, covering {article.category.toLowerCase()}.</p>
             </div>
          </div>
        )}

        {/* Related Articles */}
        <RelatedArticles category={article.category} excludeSlug={article.slug} />

      </article>

      {/* Sidebar Area (Right 1 col) for Ads & Featured */}
      <aside class="lg:col-span-1">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto space-y-8 pr-1 [scrollbar-width:thin] [scrollbar-color:#cbd5e1_transparent] dark:[scrollbar-color:#334155_transparent]">
          
          {/* Ad Slot */}
          <div class="bg-slate-100 dark:bg-slate-800 rounded-lg p-4 flex flex-col items-center justify-center border border-slate-200 dark:border-slate-700">
            <span class="text-slate-400 dark:text-slate-500 font-medium text-sm uppercase tracking-widest mb-2">Advertisement</span>
            <div class="w-full max-w-[300px] mx-auto aspect-[1/2] bg-slate-200 dark:bg-slate-700 rounded flex items-center justify-center">
              <span class="text-slate-500 dark:text-slate-400 font-bold text-center px-2">300x600 Ad</span>
            </div>
          </div>

          {/* Featured News Widget */}
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-6">
            <h3 class="text-xl font-heading font-bold text-slate-900 dark:text-white mb-4 uppercase border-b border-slate-300 dark:border-slate-800 pb-3">FEATURED <span class="text-primary font-light">NEWS</span></h3>
            {featured.length === 0 ? (
              <p class="text-sm text-slate-500 dark:text-slate-400">No other articles yet.</p>
            ) : (
              <div class="featured-scroll flex flex-col divide-y divide-slate-200 dark:divide-slate-700 max-h-[50rem] overflow-y-auto pr-1">
                {featured.map((f) => (
                  <a href={`/article/${f.slug}`} class="group block py-5 first:pt-0">
                    <div class="rounded-lg overflow-hidden aspect-video ring-1 ring-slate-200 dark:ring-slate-800">
                      <img
                        src={f.coverImage || '/logo.png'}
                        alt={f.title}
                        width="320"
                        height="180"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>
                    <h4 class="font-heading font-bold text-lg leading-snug text-slate-800 dark:text-slate-100 group-hover:text-primary transition-colors line-clamp-2 mt-3">{f.title}</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">{formatDate(f.createdAt)}</p>
                  </a>
                ))}
              </div>
            )}
          </div>
          
        </div>
      </aside>
      
    </div>
  </div>
</Layout>
