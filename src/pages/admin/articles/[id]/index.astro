---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import BackButton from '../../../../components/admin/BackButton.astro';
import { db } from '../../../../db';
import { articles, users } from '../../../../db/schema';
import { eq } from 'drizzle-orm';
import { injectLinkPreviews } from '../../../../lib/renderArticleContent';
import { formatDate, estimateReadTime } from '../../../../lib/format';

const { id } = Astro.params;
const articleId = parseInt(id!, 10);

let article: (typeof import('../../../../db/schema').articles.$inferSelect & { authorName: string | null }) | undefined;
try {
  const rows = await db
    .select({
      id: articles.id,
      title: articles.title,
      slug: articles.slug,
      content: articles.content,
      coverImage: articles.coverImage,
      category: articles.category,
      published: articles.published,
      views: articles.views,
      likes: articles.likes,
      commentsCount: articles.commentsCount,
      createdAt: articles.createdAt,
      updatedAt: articles.updatedAt,
      authorId: articles.authorId,
      authorName: users.name,
    })
    .from(articles)
    .leftJoin(users, eq(articles.authorId, users.id))
    .where(eq(articles.id, articleId));
  article = rows[0] as typeof article;
} catch {
  return Astro.redirect('/admin/articles');
}

if (!article) {
  return Astro.redirect('/admin/articles');
}

let renderedContent = article.content;
try {
  renderedContent = await injectLinkPreviews(article.content);
} catch (e) {
  console.error('Failed to inject link previews:', e);
}

const authorName = article.authorName ?? 'Staff Writer';
const dateStr = formatDate(article.createdAt);
const timeToRead = estimateReadTime(article.content);
---

<AdminLayout title={`View: ${article.title}`}>
  <div class="space-y-4">
    <!-- Breadcrumb + Actions -->
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div class="flex items-center gap-3">
        <BackButton href="/admin/articles" label="Back to Articles" />
        <nav class="flex items-center gap-2 text-sm text-base-content/60">
          <a href="/admin" class="hover:text-primary">Admin</a>
          <span>/</span>
          <a href="/admin/articles" class="hover:text-primary">Articles</a>
          <span>/</span>
          <span class="text-base-content">Preview</span>
        </nav>
      </div>
      <div class="flex gap-2">
        <a href={`/admin/articles/${article.id}/edit`} class="inline-flex items-center gap-2 rounded-md bg-primary text-primary-content px-3 py-1.5 text-sm font-medium shadow-sm hover:bg-primary/90 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit Article
        </a>
      </div>
    </div>

    {!article.published && (
      <div class="rounded-lg bg-warning/10 border border-warning/30 px-4 py-2 flex items-center gap-2">
        <span class="inline-flex items-center rounded-md bg-warning/10 text-warning px-2 py-0.5 text-xs font-medium">Draft</span>
        <span class="text-sm text-base-content/60">This article is not yet published</span>
      </div>
    )}

    <!-- Real public-site-styled preview -->
    <div class="rounded-xl border border-base-300 shadow-sm overflow-hidden bg-white dark:bg-[#121212] text-[#3B3B3B] dark:text-[#E2E8F0]">
      <div class="article-content-font mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
        <article>
          <header class="mb-8">
            <div class="mb-4 flex flex-wrap items-center gap-2">
              <span class="text-sm font-bold uppercase tracking-wider text-[#00B2A9]">
                {article.category || 'Uncategorized'}
              </span>
              <span class="text-sm text-slate-500 dark:text-slate-400">&bull;</span>
              <time class="text-sm text-slate-500 dark:text-slate-400">{dateStr}</time>
              <span class="text-sm text-slate-500 dark:text-slate-400">&bull;</span>
              <span class="text-sm text-slate-500 dark:text-slate-400">{timeToRead}</span>
            </div>
            <h1 class="mb-6 text-2xl font-extrabold leading-tight text-slate-900 dark:text-white sm:text-3xl md:text-4xl lg:text-5xl">
              {article.title || 'Untitled Article'}
            </h1>
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-slate-200 text-xl font-bold text-slate-500 dark:bg-slate-700 dark:text-slate-400">
                {authorName.charAt(0)}
              </div>
              <div>
                <p class="font-medium text-slate-900 dark:text-white">{authorName}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">{article.category || 'Uncategorized'}</p>
              </div>
            </div>
          </header>

          {article.coverImage ? (
            <div class="mb-10 aspect-video overflow-hidden rounded-2xl bg-slate-100 shadow-lg dark:bg-slate-800">
              <img src={article.coverImage} alt={article.title} class="h-full w-full object-cover" />
            </div>
          ) : (
            <div class="mb-10 flex aspect-video items-center justify-center rounded-2xl bg-slate-100 text-slate-400 shadow-lg dark:bg-slate-800 dark:text-slate-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 3l18 18M3.75 3h16.5a.75.75 0 01.75.75v16.5a.75.75 0 01-.75.75H3.75a.75.75 0 01-.75-.75V3.75a.75.75 0 01.75-.75z" />
              </svg>
            </div>
          )}

          <div class="prose prose-lg max-w-none prose-a:text-[#00B2A9] hover:prose-a:text-[#099e96] dark:prose-invert">
            <div set:html={renderedContent} />
          </div>
        </article>
      </div>
    </div>
  </div>
</AdminLayout>
