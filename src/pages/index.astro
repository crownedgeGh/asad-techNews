---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FeaturedSidebar from '../components/FeaturedSidebar.astro';
import Pagination from '../components/Pagination.astro';
import { db } from '../db';
import { articles } from '../db/schema';
import { and, eq, or, asc, desc, sql } from 'drizzle-orm';
import { formatDateTime, formatViews } from '../lib/format';
import { SITE } from '../lib/seo';
import { collectionPageSchema } from '../lib/schema';

export const prerender = false;

const PAGE_SIZE = 12;
const pageParam = Astro.url.searchParams.get('page');
const page = Math.max(1, parseInt(pageParam || '1', 10) || 1);
const offset = (page - 1) * PAGE_SIZE;

let allArticles: (typeof articles.$inferSelect)[] = [];
let totalArticles = 0;

// Tech News always appears on the homepage; other categories only opt in via the homepage toggle.
const homepageCondition = and(
  eq(articles.published, true),
  or(eq(articles.category, 'Tech News'), eq(articles.homepage, true))
);

try {
  const [rows, [{ count }]] = await Promise.all([
    db
      .select()
      .from(articles)
      .where(homepageCondition)
      .orderBy(sql`(${articles.sortOrder} = 0)`, asc(articles.sortOrder), desc(articles.createdAt))
      .limit(PAGE_SIZE)
      .offset(offset),
    db.select({ count: sql<number>`count(*)::int` }).from(articles).where(homepageCondition),
  ]);
  allArticles = rows;
  totalArticles = count;
} catch (e) {
  console.error('Failed to load articles for homepage:', e);
}

const totalPages = Math.ceil(totalArticles / PAGE_SIZE);

const jsonLd = collectionPageSchema({
  name: SITE.title,
  description: SITE.description,
  url: page > 1 ? `${SITE.url}?page=${page}` : SITE.url,
  items: allArticles.map((a) => ({ title: a.title, url: `/article/${a.slug}` })),
});
---

<Layout description={SITE.description} jsonLd={jsonLd}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="sr-only">The Lumen Tech — Technology News, Reviews & Analysis</h1>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

      {/* Main Content Area (Left 2 cols) */}
      <div class="lg:col-span-2">

        {/* Latest News Section */}
        <section>
          <h2 class="text-3xl font-heading font-bold text-slate-900 dark:text-white mb-6 uppercase border-b border-slate-300 dark:border-slate-800 pb-3">LATEST <span class="text-primary font-light">NEWS</span></h2>
          <div class="flex flex-col">
            {allArticles.length === 0 && (
              <p class="text-slate-500 dark:text-slate-400 py-12 text-center">No articles published yet.</p>
            )}
            {allArticles.map(article => (
              <ArticleCard
                title={article.title}
                imageUrl={article.coverImage || '/logo.png'}
                category={article.category}
                slug={article.slug}
                date={formatDateTime(article.createdAt)}
                views={formatViews(article.views)}
              />
            ))}
          </div>

          <Pagination currentPage={page} totalPages={totalPages} baseUrl="/" />
        </section>

      </div>

      {/* Sidebar Area (Right 1 col) for Ads */}
      <aside class="lg:col-span-1">
        <FeaturedSidebar />
      </aside>
      
    </div>
  </div>
</Layout>
