---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ArticleForm from '../../../components/admin/ArticleForm';
import BackButton from '../../../components/admin/BackButton.astro';
---

<AdminLayout title="Post Article">
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <BackButton href="/admin/articles" label="Back to Articles" />
      <div>
        <h1 class="text-2xl font-bold text-base-content">Post Article</h1>
        <p class="text-base-content/60 text-sm mt-1">Write and publish a new article</p>
      </div>
    </div>

    <div class="bg-base-100 rounded-xl border border-base-300 shadow-sm p-6 lg:p-8">
      <ArticleForm mode="create" client:load />
    </div>
  </div>
</AdminLayout>
