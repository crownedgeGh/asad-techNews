---
import Layout from '../../layouts/Layout.astro';
import SocialShare from '../../components/SocialShare';
import Comments from '../../components/Comments';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { db } from '../../db';
import { articles, users } from '../../db/schema';
import { eq, sql } from 'drizzle-orm';
import { formatDate, estimateReadTime } from '../../lib/format';
import { injectLinkPreviews } from '../../lib/renderArticleContent';

export const prerender = false;

const { slug } = Astro.params;

const rows = await db
  .select({
    id: articles.id,
    title: articles.title,
    slug: articles.slug,
    content: articles.content,
    coverImage: articles.coverImage,
    category: articles.category,
    published: articles.published,
    views: articles.views,
    likes: articles.likes,
    commentsCount: articles.commentsCount,
    createdAt: articles.createdAt,
    authorName: users.name,
  })
  .from(articles)
  .leftJoin(users, eq(articles.authorId, users.id))
  .where(eq(articles.slug, slug!));

const article = rows[0];

if (!article || !article.published) {
  return new Response(null, { status: 404 });
}

// Best-effort view counter; failures shouldn't block rendering the page.
db.update(articles)
  .set({ views: sql`${articles.views} + 1` })
  .where(eq(articles.id, article.id))
  .catch((e) => console.error('Failed to increment views:', e));

const currentUrl = Astro.url.href;
const authorName = article.authorName ?? 'Staff Writer';
const dateStr = formatDate(article.createdAt);
const timeToRead = estimateReadTime(article.content);
const coverImage = article.coverImage || '/logo.png';

let renderedContent = article.content;
try {
  renderedContent = await injectLinkPreviews(article.content);
} catch (e) {
  console.error('Failed to inject link previews:', e);
}

let featured: { id: number; title: string; slug: string; createdAt: Date }[] = [];
try {
  featured = await db
    .select({ id: articles.id, title: articles.title, slug: articles.slug, createdAt: articles.createdAt })
    .from(articles)
    .where(eq(articles.published, true))
    .orderBy(sql`${articles.views} desc`)
    .limit(3);
  featured = featured.filter((a) => a.id !== article.id).slice(0, 2);
} catch (e) {
  console.error('Failed to load featured articles:', e);
}
---

<Layout title={article.title}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
      
      {/* Main Article Content (Left 3 cols) */}
      <article class="lg:col-span-3">
        {/* Article Header */}
        <header class="mb-8">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-sm font-bold uppercase tracking-wider text-primary dark:text-primary">{article.category}</span>
            <span class="text-sm text-slate-500 dark:text-slate-400">&bull;</span>
            <time class="text-sm text-slate-500 dark:text-slate-400">{dateStr}</time>
            <span class="text-sm text-slate-500 dark:text-slate-400">&bull;</span>
            <span class="text-sm text-slate-500 dark:text-slate-400">{timeToRead}</span>
          </div>
          <h1 class="text-2xl sm:text-3xl md:text-5xl font-heading font-extrabold text-slate-900 dark:text-white leading-tight mb-6">
            {article.title}
          </h1>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-xl font-bold text-slate-500 dark:text-slate-400">
              {authorName.charAt(0)}
            </div>
            <div>
              <p class="font-medium text-slate-900 dark:text-white">{authorName}</p>
              <p class="text-sm text-slate-500 dark:text-slate-400">{article.category}</p>
            </div>
          </div>
        </header>

        {/* Social Share */}
        <SocialShare client:load url={currentUrl} title={article.title} />

        {/* Cover Image */}
        <div class="mb-10 rounded-2xl overflow-hidden shadow-lg aspect-video">
          <img src={coverImage} alt={article.title} class="w-full h-full object-cover" />
        </div>

        {/* Article Body */}
        <div class="prose prose-lg dark:prose-invert prose-headings:font-heading prose-a:text-primary dark:prose-a:text-primary hover:prose-a:text-secondary max-w-none font-body">
          <div set:html={renderedContent} />
        </div>

        {/* Inline Ad Slot (Simulated) */}
        <div class="my-10 bg-slate-100 dark:bg-slate-800 rounded-lg p-6 flex flex-col items-center justify-center min-h-[150px] border border-slate-200 dark:border-slate-700">
           <span class="text-slate-400 dark:text-slate-500 font-medium text-sm uppercase tracking-widest mb-2">Advertisement</span>
           <div class="w-full max-w-[728px] h-[90px] bg-slate-200 dark:bg-slate-700 rounded flex items-center justify-center">
             <span class="text-slate-500 dark:text-slate-400 font-bold">728x90 Leaderboard</span>
           </div>
        </div>

        {/* Comments */}
        <Comments client:load articleId={article.id} />

        {/* Author Bio Box */}
        <div class="bg-slate-50 dark:bg-slate-800/50 rounded-xl p-8 my-8 flex flex-col sm:flex-row gap-6 items-center sm:items-start border border-slate-200 dark:border-slate-700/50">
           <div class="w-24 h-24 rounded-full bg-slate-200 dark:bg-slate-700 shrink-0 flex items-center justify-center text-3xl font-extrabold text-slate-400 dark:text-slate-500">
             {authorName.charAt(0)}
           </div>
           <div>
             <h4 class="text-xl font-bold text-slate-900 dark:text-white mb-2">About {authorName}</h4>
             <p class="text-slate-600 dark:text-slate-300">Contributor at The Lumen Tech, covering {article.category.toLowerCase()}.</p>
           </div>
        </div>

        {/* Related Articles */}
        <RelatedArticles category={article.category} excludeSlug={article.slug} />

      </article>

      {/* Sidebar Area (Right 1 col) for Ads & Featured */}
      <aside class="lg:col-span-1">
        <div class="sticky top-24 space-y-8">
          
          {/* Ad Slot */}
          <div class="bg-slate-100 dark:bg-slate-800 rounded-lg p-4 flex flex-col items-center justify-center border border-slate-200 dark:border-slate-700">
            <span class="text-slate-400 dark:text-slate-500 font-medium text-sm uppercase tracking-widest mb-2">Advertisement</span>
            <div class="w-full max-w-[300px] aspect-[1/2] bg-slate-200 dark:bg-slate-700 rounded flex items-center justify-center">
              <span class="text-slate-500 dark:text-slate-400 font-bold text-center px-2">300x600 Ad</span>
            </div>
          </div>
          
          {/* Featured News Widget */}
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg p-6">
            <h3 class="font-heading font-bold text-xl text-slate-900 dark:text-white mb-4 border-b border-slate-100 dark:border-slate-800 pb-2">Featured News</h3>
            {featured.length === 0 ? (
              <p class="text-sm text-slate-500 dark:text-slate-400">No other articles yet.</p>
            ) : (
              <ul class="space-y-4">
                {featured.map((f) => (
                  <li>
                    <a href={`/article/${f.slug}`} class="group block">
                      <h4 class="font-bold text-slate-800 dark:text-slate-200 group-hover:text-primary transition-colors">{f.title}</h4>
                      <p class="text-sm text-slate-500 mt-1">{formatDate(f.createdAt)}</p>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
          
        </div>
      </aside>
      
    </div>
  </div>
</Layout>
