---
import ArticleCard from './ArticleCard.astro';
import { db } from '../db';
import { articles } from '../db/schema';
import { and, desc, eq, ne } from 'drizzle-orm';
import { formatDate, formatViews, excerptFromContent } from '../lib/format';

interface Props {
  category: string;
  excludeSlug: string;
}

const { category, excludeSlug } = Astro.props;

let relatedArticles: (typeof articles.$inferSelect)[] = [];
try {
  relatedArticles = await db
    .select()
    .from(articles)
    .where(and(eq(articles.published, true), eq(articles.category, category), ne(articles.slug, excludeSlug)))
    .orderBy(desc(articles.createdAt))
    .limit(4);
} catch (e) {
  console.error('Failed to load related articles:', e);
}
---

{relatedArticles.length > 0 && (
  <div class="mt-16">
    <h3 class="text-2xl font-heading font-bold text-slate-900 dark:text-white mb-6 border-b border-slate-200 dark:border-slate-800 pb-2">Related Articles</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {relatedArticles.map(article => (
        <ArticleCard
          title={article.title}
          excerpt={excerptFromContent(article.content)}
          imageUrl={article.coverImage || '/logo.png'}
          category={article.category}
          slug={article.slug}
          date={formatDate(article.createdAt)}
          views={formatViews(article.views)}
        />
      ))}
    </div>
  </div>
)}
