DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require

# n8n webhook that triggers the "Production Lumentech" article-generation pipeline.
# N8N_WEBHOOK_URL is the full webhook URL (e.g. https://your-ngrok-or-host/webhook/<path>).
# N8N_WEBHOOK_SECRET must match the value configured on the Webhook node's Header Auth credential.
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/run-tech-news-pipeline
N8N_WEBHOOK_SECRET=your_webhook_secret
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=your_bucket
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Google Analytics 4 measurement ID (exposed to the client, must be PUBLIC_ prefixed).
# Leave unset to disable analytics entirely.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense publisher/client ID (exposed to the client). Leave unset to disable ads.
# Same value drives the AdSense script tag, ad units, and the generated /ads.txt.
PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
