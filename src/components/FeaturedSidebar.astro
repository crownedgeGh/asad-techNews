---
import { db } from '../db';
import { articles } from '../db/schema';
import { and, eq, desc } from 'drizzle-orm';
import { formatDate } from '../lib/format';

let featuredArticles: (typeof articles.$inferSelect)[] = [];
try {
  featuredArticles = await db
    .select()
    .from(articles)
    .where(and(eq(articles.published, true), eq(articles.featured, true)))
    .orderBy(desc(articles.createdAt))
    .limit(6);
} catch (e) {
  console.error('Failed to load featured articles for sidebar:', e);
}
---

<div class="sticky top-24 space-y-8">
  {/* Featured Section */}
  {featuredArticles.length > 0 && (
    <section class="bg-white dark:bg-slate-800 rounded-lg p-6 border border-slate-200 dark:border-slate-700 shadow-sm">
      <h2 class="text-xl font-heading font-bold text-slate-900 dark:text-white mb-4 uppercase border-b border-slate-300 dark:border-slate-800 pb-3">FEATURED <span class="text-primary font-light">NEWS</span></h2>
      <div class="featured-scroll flex flex-col divide-y divide-slate-200 dark:divide-slate-700 max-h-[50rem] overflow-y-auto pr-1">
        {featuredArticles.map(article => (
          <a href={`/article/${article.slug}`} class="group block py-5 first:pt-0">
            <div class="rounded-lg overflow-hidden aspect-video ring-1 ring-slate-200 dark:ring-slate-800">
              <img
                src={article.coverImage || '/logo.png'}
                alt={article.title}
                width="320"
                height="180"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <h3 class="font-heading font-bold text-lg leading-snug text-slate-800 dark:text-slate-100 group-hover:text-primary transition-colors line-clamp-2 mt-3">{article.title}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">{formatDate(article.createdAt)}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</div>
