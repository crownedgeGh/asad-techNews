---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import BackButton from '../../../../components/admin/BackButton.astro';
import { db } from '../../../../db';
import { articles } from '../../../../db/schema';
import { eq } from 'drizzle-orm';
import { injectLinkPreviews } from '../../../../lib/renderArticleContent';

const { id } = Astro.params;
const articleId = parseInt(id!, 10);

let article: typeof import('../../../../db/schema').articles.$inferSelect | undefined;
try {
  const rows = await db.select().from(articles).where(eq(articles.id, articleId));
  article = rows[0];
} catch {
  return Astro.redirect('/admin/articles');
}

if (!article) {
  return Astro.redirect('/admin/articles');
}

let renderedContent = article.content;
try {
  renderedContent = await injectLinkPreviews(article.content);
} catch (e) {
  console.error('Failed to inject link previews:', e);
}

function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('en-US', {
    month: 'long', day: 'numeric', year: 'numeric'
  });
}
---

<AdminLayout title={`View: ${article.title}`}>
  <div class="space-y-4">
    <!-- Breadcrumb + Actions -->
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div class="flex items-center gap-3">
        <BackButton href="/admin/articles" label="Back to Articles" />
        <nav class="flex items-center gap-2 text-sm text-base-content/60">
          <a href="/admin" class="hover:text-primary">Admin</a>
          <span>/</span>
          <a href="/admin/articles" class="hover:text-primary">Articles</a>
          <span>/</span>
          <span class="text-base-content">Preview</span>
        </nav>
      </div>
      <div class="flex gap-2">
        <a href={`/admin/articles/${article.id}/edit`} class="inline-flex items-center gap-2 rounded-md bg-primary text-primary-content px-3 py-1.5 text-sm font-medium shadow-sm hover:bg-primary/90 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit Article
        </a>
        <a href="/admin/articles" class="inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium text-base-content/60 hover:bg-base-200 transition-colors">← Back</a>
      </div>
    </div>

    <!-- Article preview card -->
    <article class="bg-base-100 rounded-xl border border-base-300 shadow-sm overflow-hidden">
      <!-- Status banner -->
      {!article.published && (
        <div class="bg-warning/10 border-b border-warning/30 px-6 py-2 flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-warning/10 text-warning px-2 py-0.5 text-xs font-medium">Draft</span>
          <span class="text-sm text-base-content/60">This article is not yet published</span>
        </div>
      )}

      <!-- Cover image -->
      {article.coverImage && (
        <div class="w-full aspect-video overflow-hidden">
          <img
            src={article.coverImage}
            alt={article.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <div class="px-6 py-8 lg:px-12 lg:py-10 max-w-4xl mx-auto">
        <!-- Meta -->
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <span class="inline-flex items-center rounded-md border border-base-300 px-2 py-0.5 text-xs font-medium text-base-content">{article.category}</span>
          <span class="text-sm text-base-content/60">{formatDate(article.createdAt)}</span>
          <div class="flex items-center gap-4 text-sm text-base-content/60 ml-auto">
            <span>{article.views.toLocaleString()} views</span>
            <span>{article.likes.toLocaleString()} likes</span>
            <span>{article.commentsCount.toLocaleString()} comments</span>
          </div>
        </div>

        <!-- Title -->
        <h1 class="text-3xl lg:text-4xl font-bold text-base-content mb-6 leading-tight">
          {article.title}
        </h1>

        <!-- Content rendered same as public portal -->
        <div
          class="prose prose-slate dark:prose-invert max-w-none"
          set:html={renderedContent}
        />
      </div>
    </article>
  </div>
</AdminLayout>
